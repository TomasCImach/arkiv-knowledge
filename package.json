{
  "name": "arklib",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:live": "tsx tests/live/arkiv-live.test.ts",
    "verify:evidence": "tsx scripts/verify-evidence.ts",
    "verify:submission": "tsx scripts/verify-submission.ts",
    "verify:docs-quality": "tsx scripts/verify-docs-quality.ts",
    "evidence:capture": "tsx scripts/capture-evidence.ts",
    "migrate:gitbook": "tsx scripts/migrate-gitbook-markdown.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e && pnpm build && pnpm verify:evidence && pnpm verify:submission && pnpm test:live",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "restore:demo": "tsx scripts/restore-demo.ts",
    "verify:phase": "tsx scripts/verify-phase.ts",
    "publish:agent-docs": "tsx scripts/publish-agent-docs.ts"
  },
  "dependencies": {
    "@arkiv-network/sdk": "^0.6.0",
    "@rainbow-me/rainbowkit": "^2.2.9",
    "clsx": "^2.1.1",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remark-gfm": "^4.0.1",
    "react-markdown": "^10.1.0",
    "viem": "^2.38.6",
    "wagmi": "^2.18.1",
    "zod": "^4.1.12",
    "@tanstack/react-query": "^5.90.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.10",
    "@types/react": "^19.1.17",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.38.0",
    "eslint-config-next": "^15.5.6",
    "jsdom": "^27.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
